<UserControl x:Class="TrackMaintenance.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="24,14"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="TitleText" Text="系统设置" Style="{StaticResource PageTitle}"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,24,24,0">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">

                <!-- Language Section -->
                <Border Background="White" CornerRadius="10" Padding="24,20"
                        BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                        Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="1" Opacity="0.07"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="LangSectionTitle" Text="语言 / Language"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ChineseRadio" GroupName="Lang"
                                         Content="中文" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimary}"
                                         Margin="0,0,24,0" Checked="ChineseRadio_Checked"/>
                            <RadioButton x:Name="EnglishRadio" GroupName="Lang"
                                         Content="English" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimary}"
                                         Checked="EnglishRadio_Checked"/>
                        </StackPanel>

                        <Border Background="#FFF9C4" CornerRadius="6" Padding="12,8" Margin="0,14,0,0">
                            <TextBlock x:Name="LangNoteText"
                                       Text="更改语言后请重新启动软件以完全生效"
                                       FontSize="12" Foreground="#795548" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Background Color Section -->
                <Border Background="White" CornerRadius="10" Padding="24,20"
                        BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                        Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="1" Opacity="0.07"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="BgSectionTitle" Text="背景颜色"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                        <!-- Color swatches -->
                        <WrapPanel x:Name="ColorPanel" Orientation="Horizontal"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock x:Name="CustomColorLabel" Text="自定义颜色："
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="CustomColorBox" Width="100" Height="34"
                                     FontSize="13" VerticalContentAlignment="Center"/>
                            <Button x:Name="ApplyColorBtn" Content="应用"
                                    Style="{StaticResource PrimaryBtn}"
                                    Height="34" Margin="8,0,0,0"
                                    Click="ApplyColor_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ColorHintText"
                                   Text="输入十六进制颜色值，例如 #F0F4F8"
                                   FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- About Section -->
                <Border Background="White" CornerRadius="10" Padding="24,20"
                        BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                        Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="1" Opacity="0.07"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="AboutTitle" Text="关于"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>
                        <TextBlock Text="赛道保养管家  /  Track Maintenance Pro"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Text="版本  v1.0" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBlock Text="© Stephen Kwan  |  kwan.stephen@outlook.com"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Copyright footer -->
        <Border Grid.Row="2" Background="White" Padding="24,10"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0">
            <TextBlock Text="© Stephen Kwan  |  kwan.stephen@outlook.com"
                       FontSize="11" Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
