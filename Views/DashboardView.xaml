<UserControl x:Class="TrackMaintenance.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Alert banner -->
        <Border x:Name="AlertBanner" Grid.Row="0" Visibility="Collapsed" Padding="24,10">
            <TextBlock x:Name="AlertText" FontSize="13" FontWeight="Bold"/>
        </Border>

        <!-- Cards scroll area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,16,16,8">
            <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="暂无保养项目" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
            <TextBlock Text="前往「车辆管理」为该车辆添加保养项目" FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    
        <!-- Copyright footer -->
        <Border Grid.Row="2" Background="White" Padding="20,7"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0">
            <TextBlock Text="© Stephen Kwan  |  kwan.stephen@outlook.com"
                       FontSize="11" Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</UserControl>
