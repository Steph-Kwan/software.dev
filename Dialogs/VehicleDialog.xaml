<Window x:Class="TrackMaintenance.Dialogs.VehicleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="车辆信息" Width="460" Height="480"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI, Arial">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBlue}" Padding="24,16">
            <TextBlock x:Name="DialogTitle" Text="添加车辆"
                       Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <!-- Form -->
        <StackPanel Grid.Row="1" Margin="24,20,24,0">

            <TextBlock Text="车辆名称 *" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="年份" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="YearBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="牌照号码" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="PlateBox"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="当前里程数 (km) *" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
            <TextBox x:Name="MileageBox" Margin="0,0,0,16"/>

            <TextBlock Text="备注" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
            <TextBox x:Name="NotesBox" Height="48" AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Padding="10,8"/>
        </StackPanel>

        <!-- Buttons -->
        <Border Grid.Row="2" Padding="24,14" Background="#F8FAFC"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource OutlineBtn}"
                        Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="确认保存" Style="{StaticResource PrimaryBtn}" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
