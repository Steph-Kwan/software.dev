<Window x:Class="TrackMaintenance.Dialogs.EditItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保养项目" Width="420" Height="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI, Arial">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBlue}" Padding="24,16">
            <StackPanel>
                <TextBlock x:Name="ItemLabel" Text="保养项目" Foreground="White" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,18,24,0">

            <!-- Name fields (always visible) -->
            <StackPanel x:Name="NamePanel" Visibility="Collapsed">
                <TextBlock Text="项目名称 *" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                <TextBox x:Name="NameBox" Height="36" Margin="0,0,0,14"/>

                <TextBlock Text="英文 / 副标题（可选）" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                <TextBox x:Name="SubtitleBox" Height="36" Margin="0,0,0,14"/>
            </StackPanel>

            <TextBlock Text="保养周期 (km) *" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
            <TextBox x:Name="IntervalBox" Height="36" Margin="0,0,0,14"/>

            <TextBlock Text="每节赛道折算里程 (km) *" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
            <TextBox x:Name="AdditionBox" Height="36" Margin="0,0,0,14"/>

            <Border Background="#EFF6FF" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}">
                    例：机油  5000km 周期，赛道折算 1000km/节。
                    刹车油  40000km 周期，赛道折算 7500km/节。
                </TextBlock>
            </Border>

            <CheckBox x:Name="EnabledCheck" Content="启用此保养项目" FontSize="13"
                      Foreground="{StaticResource TextPrimary}" IsChecked="True"/>
        </StackPanel>

        <Border Grid.Row="2" Padding="24,14" Background="#F8FAFC"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource OutlineBtn}" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="保存" Style="{StaticResource PrimaryBtn}" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
