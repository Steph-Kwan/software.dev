<Window x:Class="TrackMaintenance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="赛道保养管家" Height="740" Width="1100"
        MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI, Arial"
        Background="{StaticResource ContentBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Top bar -->
            <RowDefinition Height="Auto"/>   <!-- Tab bar -->
            <RowDefinition Height="*"/>      <!-- Content -->
            <RowDefinition Height="Auto"/>   <!-- Copyright footer -->
        </Grid.RowDefinitions>

        <!-- ══ TOP BAR ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#FF007DFF" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App name -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppNameText" Text="赛道保养管家"
                               Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Track Maintenance Pro"
                               Foreground="#7BAFD4" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Vehicle selector -->
                <ComboBox Grid.Column="2" x:Name="VehicleComboBox"
                          VerticalAlignment="Center"
                          SelectionChanged="VehicleComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Odometer -->
                <Border Grid.Column="4" x:Name="OdoBorder" CornerRadius="6"
                        Background="#1A3D5C" Padding="14,0" Height="34"
                        Cursor="Hand" MouseLeftButtonUp="OdoBorder_Click"
                        ToolTip="点击快速编辑里程">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="OdoLabel" Text="里程："
                                   Foreground="#9EC8E8" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OdoText"
                                   Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="  km  ✎"
                                   Foreground="#7BAFD4" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Inline odo edit -->
                <Border Grid.Column="4" x:Name="OdoEditBorder" CornerRadius="6"
                        Background="White" Padding="4,0" Height="34"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="OdoEditBox" Width="110" BorderThickness="0"
                                 FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                 KeyDown="OdoEditBox_KeyDown" LostFocus="OdoEditBox_LostFocus"/>
                        <TextBlock Text=" km" Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Track btn -->
                <Button Grid.Column="6" x:Name="TrackBtn"
                        Content="赛道日志" Style="{StaticResource GreenBtn}"
                        Click="TrackBtn_Click"/>
            </Grid>
        </Border>

        <!-- ══ TAB BAR ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="20,0">
                <!-- 1 仪表盘 -->
                <RadioButton x:Name="TabDash"     Style="{StaticResource TabBtn}" GroupName="Tab"
                             Checked="TabDash_Checked"     Content="仪表盘"/>
                <!-- 2 保养记录 -->
                <RadioButton x:Name="TabHistory"  Style="{StaticResource TabBtn}" GroupName="Tab"
                             Checked="TabHistory_Checked"  Content="保养记录"/>
                <!-- 3 赛道日志 -->
                <RadioButton x:Name="TabTrack"    Style="{StaticResource TabBtn}" GroupName="Tab"
                             Checked="TabTrack_Checked"    Content="赛道日志"/>
                <!-- 4 车辆管理 -->
                <RadioButton x:Name="TabVehicles" Style="{StaticResource TabBtn}" GroupName="Tab"
                             Checked="TabVehicles_Checked" Content="车辆管理"/>
                <!-- 5 系统设置 -->
                <RadioButton x:Name="TabSettings" Style="{StaticResource TabBtn}" GroupName="Tab"
                             Checked="TabSettings_Checked" Content="系统设置"/>
            </StackPanel>
        </Border>

        <!-- ══ CONTENT ═══════════════════════════════════════════════════════ -->
        <ContentControl x:Name="MainContent" Grid.Row="2"
                        Background="{StaticResource ContentBg}"/>

        <!-- ══ COPYRIGHT FOOTER ══════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White" Padding="24,8"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="© Stephen Kwan  |  kwan.stephen@outlook.com"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="FooterAppName"
                           Text="赛道保养管家  v1.0"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
